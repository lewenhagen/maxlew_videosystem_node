      <div class="small_logo2">
        <img src="img/kgf_logo.png" alt="kgf logo">
      </div>
    </div>
    <div class="row">
      <div class="menu">
        <h1>Huvudmeny</h1>
        <ul>
          <li class="with-icon" lang="en"><span>1. Singlecam</span><svg class="menu-icon" viewBox="0 0 48 32" aria-hidden="true"><rect x="2" y="2" width="44" height="28" rx="3"/></svg></li>
          <li class="with-icon" lang="en"><span>2. Singlecam Quadview</span><svg class="menu-icon" viewBox="0 0 48 32" aria-hidden="true"><rect x="2" y="2" width="20" height="12" rx="2"/><rect x="26" y="2" width="20" height="12" rx="2"/><rect x="2" y="18" width="20" height="12" rx="2"/><rect x="26" y="18" width="20" height="12" rx="2"/></svg></li>
          <li class="with-icon" lang="en"><span>3. Doublecam</span><svg class="menu-icon" viewBox="0 0 48 32" aria-hidden="true"><rect x="2" y="2" width="20" height="28" rx="3"/><rect x="26" y="2" width="20" height="28" rx="3"/></svg></li>
          <hr style="margin:10px 0 10px 0">
          <li class="with-icon"><span>*. Stäng av systemet</span><svg class="menu-icon" viewBox="0 0 48 32" aria-hidden="true"><path d="M24 3v13M14 9a12 12 0 1 0 20 0" fill="none"/></svg></li>
        </ul>
      </div>
    </div>


  <!-- <div class="" style="width: 50%; margin: 0 auto; margin-top: 10%">-->
  
  <script>
    let menuTitle = document.getElementById("menuTitle")
    let menuContent = document.getElementById("menuContent")

    document.addEventListener("keydown", function(event) {
    let key = event.key
    switch (key) {
      case "*":
        // shutdown
        window.location.href = "/shutdown"
        break
      case "-":
        // refresh camera list
        break
      case "+":
        // main menu
        break
      case "1":
        // delay single cam
        window.location.replace("/singlecam", true)
        break
      case "2":
        // delay singlecam quadview
        window.location.replace("/singlecam-quad", true)
        break
      case "3":
        // delay doublecam
        window.location.replace("/doublecam", true)
        break
      case "9":
        // Easteregg
        new Audio('sound/tf.mp3').play()
        break
      case "m":
        // Admin
        window.location.replace("/admin", true)
        break
      }
    })
  </script>

  <%- include("footer.ejs") %>
 </div>