<%- include('header.ejs') %>

<div class="container">
  <div class="is-rounded" style="width: 50%; margin: 0 auto;">
    <h1><%= mode === 'add' ? 'Lägg till kamera' : 'Ändra kamera' %></h1>
    <% if (error) { %>
      <p class="red" style="margin-bottom: 1em"><%= error %></p>
    <% } %>
    <form class="selectform" method="post" action="<%= mode === 'add' ? '/admin/add' : '/admin/edit/' + id %>">
      <label for="name_field">Namn:</label>
      <input type="text" id="name_field" name="name" maxlength="40" autocomplete="off" autofocus required value="<%= camera.name %>">
      <label for="ip_field">IP-adress:</label>
      <input type="text" id="ip_field" name="ip" maxlength="15" inputmode="decimal" autocomplete="off" required value="<%= camera.ip %>">
      <input type="submit" hidden>
    </form>
    <p style="margin-top: 1em">Tab. Nästa fält &nbsp; Enter. Spara &nbsp; Esc. Avbryt</p>
  </div>
</div>

<script>
  document.addEventListener("keydown", function (event) {
    if (event.key === "Escape") {
      window.location.replace("/admin", true)
    }
  })
</script>

<%- include('footer.ejs') %>
