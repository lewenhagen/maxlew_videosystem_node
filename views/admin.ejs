<%- include("header.ejs") %>
  <div class="wrapper">

    <div class="top-row">
      <div class="small_logo">
        <img src="/img/maxlew_logo_2025.svg" alt="maxlew logo">
      </div>
      <div class="small_logo2">
        <img src="/img/kgf_logo.png" alt="kgf logo">
      </div>
    </div>
    <div class="row">
      <div class="menu">
        <h1>Admin: Kameror</h1>
        <% if (message) { %>
          <p class="green" style="margin-bottom: 1em"><%= message %></p>
        <% } %>
        <% if (cameras.length === 0) { %>
          <p>Inga kameror är inlagda.</p>
        <% } else { %>
          <ul id="cameras">
            <% cameras.forEach(function (cam, i) { %>
              <li class="<%= i === selected ? 'selected' : '' %>"><%= i + 1 %>. <%= cam.name %> <span class="logocolor">(<%= cam.ip %>)</span></li>
            <% }) %>
          </ul>
        <% } %>
        <hr style="margin:10px 0 10px 0">
        <ul>
          <li>a. Lägg till kamera</li>
          <% if (cameras.length > 0) { %>
            <li>↑ ↓ Välj kamera</li>
            <li>Enter. Ändra vald kamera</li>
            <li>d. Ta bort vald kamera</li>
          <% } %>
          <li>+. Huvudmeny</li>
        </ul>
      </div>
    </div>

  <script>
    const items = Array.from(document.querySelectorAll("#cameras li"))
    let selected = <%= selected %>

    function select (i) {
      if (items.length === 0) return
      selected = Math.max(0, Math.min(items.length - 1, i))
      items.forEach((item, n) => item.classList.toggle("selected", n === selected))
      items[selected].scrollIntoView({ block: "nearest" })
    }

    document.addEventListener("keydown", function (event) {
      switch (event.key) {
        case "ArrowUp":
          event.preventDefault()
          select(selected - 1)
          break
        case "ArrowDown":
          event.preventDefault()
          select(selected + 1)
          break
        case "Enter":
          if (items.length > 0) window.location.replace("/admin/edit/" + selected, true)
          break
        case "a":
          window.location.replace("/admin/add", true)
          break
        case "d":
        case "Delete":
          if (items.length > 0) window.location.replace("/admin/remove/" + selected, true)
          break
        case "+":
        case "Escape":
          window.location.replace("/", true)
          break
      }
    })
  </script>

  <%- include("footer.ejs") %>
 </div>
